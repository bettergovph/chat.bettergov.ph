# Switch with: npm run provider:use -- nyolab (or zai).
LLM_PROVIDER=nyolab
LLM_FALLBACK_PROVIDER=zai
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
ZAI_API_KEY=your-zai-key
ZAI_MODEL=glm-5.3-flash
NYOLAB_BASE_URL=https://llm.nyolab.ai/api/public/v1
NYOLAB_API_KEY=your-nyolab-router-key
NYOLAB_MODEL=glm-5.3-flash
LLM_REASONING_EFFORT=low
LLM_STREAMING=auto
# Optional per-provider overrides: ZAI_REASONING_EFFORT / NYOLAB_REASONING_EFFORT.
# LLM_PROVIDER=custom uses LLM_BASE_URL, LLM_API_KEY and LLM_MODEL instead.
# Set LLM_FALLBACK_PROVIDER=off to disable cross-provider failover.
MEILI_URL=https://search2.bettergov.ph
MEILI_API_KEY=your-search-key
TYPESAFE_API_KEY=your-typesafe-key
TYPESAFE_MODEL=jev-latest

# Public app origin when using a trusted HTTPS reverse proxy (optional).
APP_ORIGIN=

# Disable new chat requests immediately if needed.
CHAT_ENABLED=true
# For forks, set your canonical public site URL before building.
NEXT_PUBLIC_SITE_URL=https://chat.example.org
